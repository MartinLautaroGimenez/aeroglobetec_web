# Servidor de documentos de AeroGlobETec · copiá este archivo como .env y completalo.
# El .env NO se sube a git (tiene la clave secreta).

# Puerto donde escucha (detrás de Caddy, Cloudflare Tunnel o nginx)
PORT=1234

# Supabase: Project Settings → API Keys
SUPABASE_URL=https://nveisqekmbcdvnuebice.supabase.co
# La "publishable key" (la misma que está en app/js/config.js)
SUPABASE_ANON_KEY=sb_publishable_...
# La "secret key". Solo vive en este servidor: NUNCA va en el código ni en la web.
SUPABASE_SERVICE_KEY=sb_secret_...

# Desde qué páginas se puede conectar, separadas por coma
ALLOWED_ORIGINS=https://aeroglobe.wetec.um.edu.ar,http://localhost:8765

# Cada cuántos minutos de trabajo se guarda una versión automática en el historial
VERSION_EVERY_MIN=30
# Cuántas versiones automáticas se guardan por documento (las que tienen nombre no se borran)
MAX_AUTO_VERSIONS=60

# ---------- Google Docs (opcional) ----------
# Cliente OAuth de Google Cloud (tipo "Aplicación web"). Ver README, sección Google Docs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que estar cargada igual en el cliente OAuth ("URIs de redireccionamiento autorizados")
GOOGLE_REDIRECT_URI=https://docs.tudominio.com/google/callback
# Clave para abrir /google/conectar (inventá una larga; solo la usa quien conecta la cuenta del taller)
GOOGLE_SETUP_KEY=
# Dónde se guarda la conexión con la cuenta del taller (tiene que ser escribible).
# Sin esto: ./google.json (con Docker: /datos/google.json, en un volumen).
# GOOGLE_STATE_FILE=/var/lib/aeroglobetec-docs/google.json
