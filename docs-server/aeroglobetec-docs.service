# Servicio de systemd (si no usás Docker). Copialo a /etc/systemd/system/ y:
#   systemctl daemon-reload && systemctl enable --now aeroglobetec-docs
[Unit]
Description=AeroGlobETec · servidor de documentos colaborativos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aeroglobe
WorkingDirectory=/opt/aeroglobetec_web/docs-server
EnvironmentFile=/opt/aeroglobetec_web/docs-server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
